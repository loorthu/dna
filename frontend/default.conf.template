# DNA frontend server block. Serves the static SPA and reverse-proxies the API
# and WebSocket to the DNA backend (which runs on another host with internet).
# ${BACKEND_URL} is substituted at container start by the nginx image's envsubst
# (set BACKEND_URL, e.g. http://160.33.19.70:8000). Nginx's own $vars are left
# alone (they aren't in the environment).
#
# ${APP_BASE_PATH} is where the app is mounted: EMPTY for a site serving DNA at the root, and
# something like "/dna" for one serving it beside other tools under a single hostname. Empty,
# every location below reads exactly as it did before this variable existed, which is what lets
# one image serve both. It must be exported EVEN WHEN EMPTY — envsubst only replaces variables it
# finds in the environment and would otherwise leave the literal text in the config — so the
# Dockerfile gives it an empty default. The build-time half is VITE_BASE_PATH; the two have to
# agree, and frontend/packages/app/src/basePath.ts says why.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Stated rather than inherited. The default is 1 MB, which is ample for every body
    # that crosses this proxy (the largest is the collector's archive metadata — a path
    # and a hash), but an accidental limit is a bad thing to discover from a 413.
    client_max_body_size 4m;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    # API -> backend. The frontend is built with VITE_API_BASE_URL=/api, so all
    # API calls arrive under /api/ and are forwarded with the /api prefix stripped
    # (trailing slash on proxy_pass). ^~ prevents the static-asset regex below
    # from hijacking API paths.
    location ^~ ${APP_BASE_PATH}/api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # Review player's session directory (Follow Along) -> ${REVIEW_SESSIONS_URL}.
    # Serving it from this origin is what makes it reachable at all: the
    # directory is a separate service that sends no CORS headers, so the SPA
    # cannot read it cross-origin. Nothing about the player belongs in the DNA
    # backend, so the mapping lives here, in deployment config.
    #
    # Left unset it parks on a dead local port, which keeps this block valid
    # and the feature unavailable — the same thing an unset
    # VITE_FOLLOW_ALONG_SESSIONS_URL means to the app.
    location ^~ ${APP_BASE_PATH}/review-sessions/ {
        proxy_pass ${REVIEW_SESSIONS_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    # Archived meeting recordings, served straight off the share.
    #
    # Deliberately NOT proxied through the backend. These are the one thing the browser
    # needs that already lives on this side of the airgap, and serving them locally is
    # what makes seeking work: nginx handles Range requests natively, so jumping to a
    # shot's offset fetches that span alone instead of dragging the file through a proxy
    # hop that drops Content-Range. No auth hop either — the share is trusted, and the
    # player is a plain <video src>.
    #
    # RECORDING_NETWORK_PATH is the share ROOT (in prod, /shots), not a directory of
    # recordings: the collector files each one under its own show and date, so the URL
    # carries that whole relative path and this location maps the tree rather than one
    # folder. The MEDIA-ONLY REGEX is what keeps that from meaning "publish the share":
    # only .mp4 and .jpg are reachable, so the rest of a show tree is not served even
    # though it sits under the same root. nginx normalises "../" out of a URI before
    # matching, so a path cannot climb out of the root either.
    #
    # A 404 here is a normal state, not a fault: it means the collector has not finished
    # yet. The player asks the API what to show and this location only serves bytes.
    location ~ "^${APP_BASE_PATH}/recordings/(?<recording_file>[A-Za-z0-9._/-]+\.(?:mp4|jpg))$" {
        alias ${RECORDING_NETWORK_PATH}/$recording_file;
        # Written once and never modified, so it caches well — but privately: a review
        # recording should not sit in a shared proxy. Set with add_header alone, since
        # `expires` would emit a second, competing Cache-Control.
        add_header Cache-Control "private, max-age=3600";
    }

    # Anything else under /recordings/ is not a recording. A PLAIN prefix location, never `^~`:
    # a `^~` match would preempt the regex above and take the recordings with it. Regexes are
    # tried first, so this catches only what the one above declined.
    #
    # Without it those URLs reach the SPA fallback, which answers 200 with a page of HTML — and
    # a <video src> given HTML and a 200 fails in a way that looks like a broken player rather
    # than a missing file.
    location ${APP_BASE_PATH}/recordings/ {
        return 404;
    }

    # WebSocket (live transcription events) -> backend /ws
    location ${APP_BASE_PATH}/ws {
        proxy_pass ${BACKEND_URL}/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Long-cache hashed static assets.
    #
    # Captures the path AFTER the mount point and aliases it, rather than inheriting `root` and
    # letting nginx join the whole URI: under a prefix, `root` would look for
    # /usr/share/nginx/html/dna/assets/x.js and 404 on every asset in the bundle. With
    # APP_BASE_PATH empty the capture is the whole path and this resolves exactly as `root` did.
    #
    # Declared AFTER the recordings regex on purpose — nginx takes the first matching regex, and
    # a poster frame is a .jpg that must be served off the share, not from the bundle.
    location ~* "^${APP_BASE_PATH}/(?<asset_path>.+\.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))$" {
        alias /usr/share/nginx/html/$asset_path;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback. `alias` rather than `root` so the mount path comes off before the file is
    # looked up: /dna/assets/x.js is /usr/share/nginx/html/assets/x.js. With APP_BASE_PATH empty
    # this is `location /` aliasing the same directory, which is what `root` did.
    location ${APP_BASE_PATH}/ {
        alias /usr/share/nginx/html/;
        try_files $uri ${APP_BASE_PATH}/index.html;
    }

    # Container healthcheck (frontend only; the API health is /api/health)
    location = ${APP_BASE_PATH}/healthz {
        access_log off;
        return 200 'OK';
        add_header Content-Type text/plain;
    }
}
