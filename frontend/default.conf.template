# DNA frontend server block. Serves the static SPA and reverse-proxies the API
# and WebSocket to the DNA backend (which runs on another host with internet).
# ${BACKEND_URL} is substituted at container start by the nginx image's envsubst
# (set BACKEND_URL, e.g. http://160.33.19.70:8000). Nginx's own $vars are left
# alone (they aren't in the environment).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Stated rather than inherited. The default is 1 MB, which is ample for every body
    # that crosses this proxy (the largest is the collector's archive metadata — a path
    # and a hash), but an accidental limit is a bad thing to discover from a 413.
    client_max_body_size 4m;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    # API -> backend. The frontend is built with VITE_API_BASE_URL=/api, so all
    # API calls arrive under /api/ and are forwarded with the /api prefix stripped
    # (trailing slash on proxy_pass). ^~ prevents the static-asset regex below
    # from hijacking API paths.
    location ^~ /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # Review player's session directory (Follow Along) -> ${REVIEW_SESSIONS_URL}.
    # Serving it from this origin is what makes it reachable at all: the
    # directory is a separate service that sends no CORS headers, so the SPA
    # cannot read it cross-origin. Nothing about the player belongs in the DNA
    # backend, so the mapping lives here, in deployment config.
    #
    # Left unset it parks on a dead local port, which keeps this block valid
    # and the feature unavailable — the same thing an unset
    # VITE_FOLLOW_ALONG_SESSIONS_URL means to the app.
    location ^~ /review-sessions/ {
        proxy_pass ${REVIEW_SESSIONS_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    # Archived meeting recordings, served straight off the share.
    #
    # Deliberately NOT proxied through the backend. These are the one thing the browser
    # needs that already lives on this side of the airgap, and serving them locally is
    # what makes seeking work: nginx handles Range requests natively, so jumping to a
    # shot's offset fetches that span alone instead of dragging the file through a proxy
    # hop that drops Content-Range. No auth hop either — the share is trusted, and the
    # player is a plain <video src>.
    #
    # ^~ so the long-cache asset regex below cannot claim these instead.
    # A 404 here is a normal state, not a fault: it means the collector has not finished
    # yet. The player asks the API what to show and this location only serves bytes.
    location ^~ /recordings/ {
        alias ${RECORDING_NETWORK_PATH}/;
        # Written once and never modified, so it caches well — but privately: a review
        # recording should not sit in a shared proxy. Set with add_header alone, since
        # `expires` would emit a second, competing Cache-Control.
        add_header Cache-Control "private, max-age=3600";
    }

    # WebSocket (live transcription events) -> backend /ws
    location /ws {
        proxy_pass ${BACKEND_URL}/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Long-cache hashed static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Container healthcheck (frontend only; the API health is /api/health)
    location = /healthz {
        access_log off;
        return 200 'OK';
        add_header Content-Type text/plain;
    }
}
