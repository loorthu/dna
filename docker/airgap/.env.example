# DNA prod deployment — FRONTEND ONLY.
# The DNA backend + mongo run on ANOTHER host (with internet, for Gemini/Gmail);
# this frontend reverse-proxies to it. Copy to docker/airgap/.env (gitignored).
#   cp docker/airgap/.env.example docker/airgap/.env

DNA_TAG=airgap
DNA_FRONTEND_PORT=8081

# The DNA backend host (API + WS). nginx reverse-proxies /api and /ws here.
# Runtime env (not baked) — change it without rebuilding the image.
BACKEND_URL=http://160.33.19.70:8000

# npm mirror for building the frontend on the air-gapped host (Artifactory).
# Leave EMPTY to build on an internet-connected machine (public registry).
NPM_REGISTRY=http://artifactory.spimageworks.com/api/npm/npm/

# ============================================================================
# Frontend build-time args (baked into the static bundle).
#   VITE_API_BASE_URL=/api  -> relative; nginx proxies /api to BACKEND_URL.
#   VITE_WS_URL (empty)     -> app derives ws://<this-origin>/ws (nginx proxies /ws).
# ============================================================================
VITE_API_BASE_URL=/api
VITE_WS_URL=
VITE_AUTH_PROVIDER=none
VITE_GOOGLE_CLIENT_ID=

# ============================================================================
# Follow Along — mirror a live review session's current clip.
# Off unless the broker and topic are both set; they name the review player the
# site runs, so there are no defaults.
#
# The session directory is proxied rather than called directly: it sends no CORS
# headers, so the browser can only read it from this origin. Runtime env, like
# BACKEND_URL — REVIEW_SESSIONS_URL is where nginx forwards /review-sessions.
# ============================================================================
# REVIEW_SESSIONS_URL=http://edbot.example.com:8080
# VITE_FEATURE_FOLLOW_ALONG=true
# VITE_FOLLOW_ALONG_BROKER_URL=ws://mq.example.com:61614/stomp
# VITE_FOLLOW_ALONG_TOPIC=/topic/itview/current_clip.xml
VITE_FOLLOW_ALONG_SESSIONS_URL=/review-sessions

# ============================================================================
# Meeting recordings — the collector.
#
# It mirrors each meeting's media out of Vexa (through the DNA backend, which
# is the only path across the airgap) while the meeting runs, muxes in the
# audio, and writes the finished MP4 here. nginx serves this same path at
# /recordings/, so the player streams it with native Range support.
#
# The path is used INSIDE both containers as well as outside, so whatever is
# set here is also the network_path recorded in DNA — keep it the real mount.
# ============================================================================
RECORDING_NETWORK_PATH=/net/media/dna-recordings
COLLECTOR_POLL_SECONDS=10
# The uid:gid the collector runs as, and therefore the owner of every archived file.
# Set these to an account that can WRITE the mount above — `stat -c '%u:%g' <mount>` on the host
# is usually the answer. nginx must be able to READ what it writes (the files are 0644).
# Leave unset to use the image's unprivileged 1000:1000, which is right only if that happens to
# own the share. Not root: an archive is the only copy of its meeting once the upstream copy is
# released, and a root-owned file cannot be rotated or removed by whoever owns the share.
COLLECTOR_UID=
COLLECTOR_GID=
# Only if the backend runs with AUTH_PROVIDER set to something other than none.
DNA_API_TOKEN=

# The collector image installs from PyPI (httpx + a bundled static ffmpeg).
# Point these at Artifactory to build on the air-gapped host; leave them at the
# defaults to build on an internet-connected machine and transfer the image.
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=
