# DNA air-gap config. Copy to docker/airgap/.env and fill in real values.
#   cp docker/airgap/.env.example docker/airgap/.env
# Keep the real .env OUT of git (it holds secrets). Carry it to prod out-of-band.

# Image tag (must match what build.sh / save.sh used; default: airgap)
DNA_TAG=airgap

# Host ports
DNA_API_PORT=8000
DNA_FRONTEND_PORT=8081

# --- ShotGrid ---------------------------------------------------------------
PRODTRACK_PROVIDER=shotgrid
SHOTGRID_URL=https://spi.shotgrid.autodesk.com
SHOTGRID_SCRIPT_NAME=shotgun-web
SHOTGRID_API_KEY=CHANGE_ME

# --- Vexa -------------------------------------------------------------------
# api-gateway is reachable by name over the shared vexa_vexa network.
VEXA_API_URL=http://api-gateway:8000
VEXA_API_KEY=CHANGE_ME

# --- LLM --------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Auth -------------------------------------------------------------------
AUTH_PROVIDER=none

# --- Transcript publishing --------------------------------------------------
DNA_ENABLE_TRANSCRIPT_PUBLISH=false
SHOTGRID_TRANSCRIPT_ENTITY=CustomEntity01

# --- Email (Gmail) ----------------------------------------------------------
EMAIL_PROVIDER=gmail
EMAIL_SENDER=you@imageworks.com
# Host directory containing client_secret.json and token.json (mounted read-only).
GMAIL_CREDENTIALS_HOST_DIR=./gmail-credentials

# ============================================================================
# Frontend build-time args (baked into the static bundle by build.sh).
# These must point at URLs the END USER's BROWSER can reach on prod.
# ============================================================================
VITE_API_BASE_URL=http://PROD_HOST:8000
VITE_WS_URL=ws://PROD_HOST:8000
VITE_AUTH_PROVIDER=none
VITE_GOOGLE_CLIENT_ID=
