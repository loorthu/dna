# DNA prod deployment — FRONTEND ONLY.
# The DNA backend + mongo run on ANOTHER host (with internet, for Gemini/Gmail);
# this frontend reverse-proxies to it. Copy to docker/airgap/.env (gitignored).
#   cp docker/airgap/.env.example docker/airgap/.env
#
# ---------------------------------------------------------------------------
# THIS FILE CARRIES NO CREDENTIALS, deliberately. Credentials live where the
# ASWF upstream expects them, so a new one arriving upstream has one home:
#
#   backend credentials -> backend/docker-compose.local.yml  (from the tracked
#                          example.docker-compose.local.yml — upstream keeps
#                          secrets INLINE in a gitignored compose override)
#   frontend config     -> frontend/packages/app/.env        (from .env.example)
#   vexa credentials    -> <vexa repo>/deploy/compose/.env   (from .env.example)
#
# What belongs here is only what an air-gapped deployment ADDS: image tags, host
# ports, the share mount, build mirrors, and the few frontend values whose
# deployed form differs from the dev form.
#
# build.sh / up.sh / down.sh layer the files, upstream first, this one second:
#
#   docker compose --env-file frontend/packages/app/.env \
#                  --env-file docker/airgap/.env ...
#
# Compose takes the LAST definition of a repeated key, so anything set here
# overrides its upstream counterpart, and anything NOT set here is inherited.
# That is why the Follow Along block below is commented out: those values live
# once, in the app's .env, and cannot drift out of step with it.
#
# Inheritance covers the VALUE, not the declaration: compose only passes build
# args that docker-compose.frontend.yml lists under `args:`. A brand-new VITE_*
# from upstream needs one line added there — but never a line in this file.
# ---------------------------------------------------------------------------

DNA_TAG=airgap
DNA_FRONTEND_PORT=8081

# The DNA backend host (API + WS). nginx reverse-proxies /api and /ws here.
# Runtime env (not baked) — change it without rebuilding the image.
BACKEND_URL=http://160.33.19.70:8000

# npm mirror for building the frontend on the air-gapped host (Artifactory).
# Leave EMPTY to build on an internet-connected machine (public registry).
NPM_REGISTRY=http://artifactory.spimageworks.com/api/npm/npm/

# ============================================================================
# Frontend build-arg OVERRIDES (baked into the static bundle).
#
# ONLY the keys whose deployed value differs from the dev value belong here.
# VITE_AUTH_PROVIDER, VITE_GOOGLE_CLIENT_ID and the Follow Along block are
# inherited from frontend/packages/app/.env — set them THERE, not here.
#   VITE_API_BASE_URL=/api  -> relative; nginx proxies /api to BACKEND_URL.
#   VITE_WS_URL (empty)     -> app derives ws://<this-origin>/ws (nginx proxies /ws).
#
# DO NOT DELETE THE EMPTY VITE_WS_URL LINE. It reads as dead config, but it is
# what overrides the dev value inherited from frontend/packages/app/.env. Remove
# it and the layering falls through to ws://localhost:8000/ws, which gets baked
# into the image: every browser then opens a socket to its OWN localhost, so
# live updates die silently — and on an HTTPS page ws:// is blocked outright.
# An empty assignment overrides; an absent key inherits.
# ============================================================================
VITE_API_BASE_URL=/api
VITE_WS_URL=

# ============================================================================
# Follow Along — mirror a live review session's current clip.
# Off unless the broker and topic are both set; they name the review player the
# site runs, so there are no defaults.
#
# The session directory is proxied rather than called directly: it sends no CORS
# headers, so the browser can only read it from this origin. Runtime env, like
# BACKEND_URL — REVIEW_SESSIONS_URL is where nginx forwards /review-sessions.
#
# The VITE_FOLLOW_ALONG_* keys are NOT set here: they are identical in dev and
# deployment, so they live once in frontend/packages/app/.env and are inherited.
# Only REVIEW_SESSIONS_URL is deployment-specific (it is where THIS host's nginx
# forwards), so only it belongs in this file.
#
# The backend half of Follow Along is PRODTRACK_VERSION_EXTERNAL_REF_FIELD, in
# backend/docker-compose.local.yml. Without it no version carries an external_ref,
# nothing matches, and every clip change reports "Review moved off this playlist".
# ============================================================================
# REVIEW_SESSIONS_URL=http://edbot.example.com:8080

# Playlist reset. Turns on DELETE /playlists/{id}/data, which forgets one playlist's
# stored transcript, metadata and draft notes so an end-to-end test can be re-run.
# scripts/reset-playlist-data.sh calls it: the recording host reaches the backend only
# over this API, so without it a reset there cannot clear the database half.
# Leave false outside a test deployment. It never touches the production tracking system.
DNA_ENABLE_PLAYLIST_RESET=false

# ============================================================================
# Meeting recordings — the collector.
#
# It mirrors each meeting's media out of Vexa (through the DNA backend, which
# is the only path across the airgap) while the meeting runs, muxes in the
# audio, and writes the finished MP4 under this ROOT. nginx serves the same
# root at /recordings/, so the player streams it with native Range support.
#
# A ROOT, not a folder of recordings. Each one is filed as
#
#   <root>/<show>/lib.recording/pix/ref/dna/<YYYYMMDD>/<playlist>_<start>_Recording.mp4
#
# so it lands in the show's own reference library, where the people on that
# show already look. DNA works the name out (it is the side that can see the
# tracking system) and the collector writes it; only the root is set here.
# In prod that root is /shots.
#
# The path is used INSIDE both containers as well as outside, so whatever is
# set here is also the root the network_path recorded in DNA is relative to —
# keep it the real mount.
# ============================================================================
RECORDING_NETWORK_PATH=/shots
# The clock the date directory and the filename timestamp are rendered in — the
# studio's, because the name is read by the people who were in the meeting.
# Set on the BACKEND, which does the naming, not on this host. Default below.
# RECORDING_ARCHIVE_TIMEZONE=America/Los_Angeles
# The path between the show and the dated directory. A studio convention, so it
# is not normally set; override only on a test share that is not a show tree.
# RECORDING_ARCHIVE_SUBPATH=lib.recording/pix/ref/dna
COLLECTOR_POLL_SECONDS=10
# How far into a shot's span its thumbnail is grabbed from. The span opens the instant the
# operator marked the shot, which is routinely a beat before the shared screen catches up — so the
# literal first frame often shows the shot BEFORE this one. Raise it if this room is slower.
RECORDING_POSTER_LEAD_SECONDS=2
# Which side this deployment is, for routing recording work to the right collector. It must match
# what the backend infers for this host's front end — the backend logs that value when a bot is
# dispatched, and DNA_COLLECTOR_SITES on the backend maps addresses to names. Leave empty if only
# one collector exists across the whole deployment.
COLLECTOR_SITE=
# The uid:gid the collector runs as, and therefore the owner of every archived file.
# Set these to an account that can WRITE the mount above — `stat -c '%u:%g' <mount>` on the host
# is usually the answer. nginx must be able to READ what it writes (the files are 0644).
# Leave unset to use the image's unprivileged 1000:1000, which is right only if that happens to
# own the share. Not root: an archive is the only copy of its meeting once the upstream copy is
# released, and a root-owned file cannot be rotated or removed by whoever owns the share.
COLLECTOR_UID=
COLLECTOR_GID=
# Only if the backend runs with AUTH_PROVIDER set to something other than none.
DNA_API_TOKEN=

# The collector image installs from PyPI (httpx + a bundled static ffmpeg).
# Point these at Artifactory to build on the air-gapped host; leave them at the
# defaults to build on an internet-connected machine and transfer the image.
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=
