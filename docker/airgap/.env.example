# DNA air-gap config. Copy to docker/airgap/.env and fill in real values.
#   cp docker/airgap/.env.example docker/airgap/.env
# Keep the real .env OUT of git (secrets). Gitignored.

# Image tag
DNA_TAG=airgap

# Host ports (on the DNA host, e.g. bear0315)
DNA_API_PORT=8000
DNA_FRONTEND_PORT=8081

# ============================================================================
# Build mirrors — for building on an air-gapped host via internal Artifactory.
# Leave EMPTY when building on an internet-connected machine (uses public
# pip/npm). Values below are the SPI Artifactory mirrors.
# ============================================================================
PIP_INDEX_URL=https://artifactory.spimageworks.com/api/pypi/pypi/simple
PIP_TRUSTED_HOST=artifactory.spimageworks.com
NPM_REGISTRY=http://artifactory.spimageworks.com/api/npm/npm/

# --- ShotGrid ---------------------------------------------------------------
PRODTRACK_PROVIDER=shotgrid
SHOTGRID_URL=https://spi.shotgrid.autodesk.com
SHOTGRID_SCRIPT_NAME=shotgun-web
SHOTGRID_API_KEY=CHANGE_ME

# --- Vexa (runs on a DIFFERENT host — reached over the network) -------------
VEXA_API_URL=http://160.33.19.70:18056
VEXA_API_KEY=CHANGE_ME   # mint on the vexa host: ./docker/airgap/mint-token.sh

# --- LLM --------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Auth / CORS ------------------------------------------------------------
AUTH_PROVIDER=none
# If the browser hits the frontend on a different origin than the API, list it
# here (comma-separated), e.g. http://bear0315:8081
CORS_ORIGINS=

# --- Transcript publishing --------------------------------------------------
DNA_ENABLE_TRANSCRIPT_PUBLISH=false
SHOTGRID_TRANSCRIPT_ENTITY=CustomEntity01

# --- Email (Gmail) ----------------------------------------------------------
EMAIL_PROVIDER=gmail
EMAIL_SENDER=you@imageworks.com
GMAIL_CREDENTIALS_HOST_DIR=./gmail-credentials

# ============================================================================
# Frontend build-time args — baked into the static bundle.
# MUST be URLs the end user's BROWSER can reach (the DNA host, e.g. bear0315).
# ============================================================================
VITE_API_BASE_URL=http://bear0315:8000
VITE_WS_URL=ws://bear0315:8000
VITE_AUTH_PROVIDER=none
VITE_GOOGLE_CLIENT_ID=
